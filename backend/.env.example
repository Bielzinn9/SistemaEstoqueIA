PORT=3333

# Banco PostgreSQL (use DATABASE_URL OU as variáveis DB_*)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=reservas_restaurante
# DATABASE_URL=postgres://usuario:senha@localhost:5432/reservas_restaurante

# Origem(ns) permitida(s) pelo CORS, separadas por vírgula (vazio = qualquer uma)
CORS_ORIGIN=http://localhost:5173

# Regras do restaurante (opcionais; valores abaixo são os padrões)
# TZ_RESTAURANTE=America/Sao_Paulo
# HORARIO_ABERTURA=11:00
# HORARIO_ULTIMA_RESERVA=22:00
# INTERVALO_MINUTOS=30
# MAX_PESSOAS_POR_RESERVA=12
# CAPACIDADE_POR_HORARIO=40
# DIAS_ANTECEDENCIA_MAX=90
